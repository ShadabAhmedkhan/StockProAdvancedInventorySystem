// Stock Pro database schema.
//
// Conventions
//  - Every business table carries `id`, `createdAt` and `updatedAt`.
//  - `deletedAt` exists only where a row is referenced by historical records
//    and therefore must never be physically removed (catalogue and parties).
//    Transactional records use a status instead.
//  - Money is `Decimal(14, 2)`. Floating point is never used for money.
//  - Table and column names use Prisma defaults so the schema is the single
//    source of truth for both; all access goes through the generated client.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REPAIR_IN
  REPAIR_OUT
  TRANSFER_OUT
  TRANSFER_IN
}

/// What caused a stock movement. `referenceId` points at a row of that kind.
enum StockReferenceType {
  ORDER
  RETURN
  REPAIR
  PURCHASE
  MANUAL
  TRANSFER
  STOCK_COUNT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentReferenceType {
  ORDER
  REPAIR
  RETURN
}

enum DeviceType {
  PHONE
  TABLET
  LAPTOP
  DESKTOP
  SMARTWATCH
  ACCESSORY
  OTHER
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  WAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  WARRANTY
  OTHER
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SUPPLIES
  MARKETING
  MAINTENANCE
  TRANSPORT
  TAXES
  OTHER
}

enum TransactionType {
  SALE
  REFUND
  EXPENSE
  REPAIR_PAYMENT
  OTHER_INCOME
}

enum TransactionReferenceType {
  ORDER
  REPAIR
  RETURN
  EXPENSE
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  REPAIR_READY
  REPAIR_OVERDUE
  ORDER_COMPLETED
  PURCHASE_RECEIVED
  TRIAL_EXPIRING
  SUBSCRIPTION_PAYMENT_FAILED
}

enum AutomationConditionOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  LESS_THAN
}

/// The only actions a rule may perform. Deliberately a closed set - "don't
/// let arbitrary user-defined code execute" - so adding a new capability
/// means shipping code, not letting a tenant configure one.
enum AutomationActionType {
  NOTIFY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  ROLE_CHANGED
  STATUS_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  STOCK_ADJUSTED
  ORDER_COMPLETED
  ORDER_CANCELLED
  RETURN_APPROVED
  RETURN_COMPLETED
  REPAIR_STATUS_CHANGED
  PAYMENT_RECORDED
  EXPENSE_RECORDED
  PURCHASE_ORDER_APPROVED
  PURCHASE_ORDER_ORDERED
  PURCHASE_ORDER_CANCELLED
  GOODS_RECEIPT_RECORDED
  STOCK_TRANSFER_REQUESTED
  STOCK_TRANSFER_APPROVED
  STOCK_TRANSFER_SHIPPED
  STOCK_TRANSFER_COMPLETED
  STOCK_TRANSFER_CANCELLED
  STOCK_COUNT_APPROVED
  STOCK_COUNT_COMPLETED
  STOCK_COUNT_CANCELLED
}

enum AuditEntity {
  AUTH
  USER
  CUSTOMER
  SUPPLIER
  CATEGORY
  BRAND
  PRODUCT
  INVENTORY
  ORDER
  REPAIR
  RETURN
  EXPENSE
  PAYMENT
  SETTING
  ORGANIZATION
  PURCHASE_ORDER
  GOODS_RECEIPT
  STOCK_TRANSFER
  PRODUCT_UNIT
  STOCK_COUNT
}

/// The stock count lifecycle:
/// DRAFT -> COUNTING -> REVIEW -> APPROVED -> COMPLETED, with CANCELLED
/// reachable from DRAFT, COUNTING or REVIEW (not once stock has been
/// adjusted, which happens atomically on the REVIEW -> APPROVED transition).
enum StockCountStatus {
  DRAFT
  COUNTING
  REVIEW
  APPROVED
  COMPLETED
  CANCELLED
}

/// A product's unit-level identity tracking strategy. NONE is the default
/// for goods sold in bulk (cables, accessories); SERIAL/IMEI apply to
/// products where each physical unit is individually identifiable (phones,
/// laptops). Never forced onto every product - see Product.trackingType.
enum ProductTrackingType {
  NONE
  SERIAL
  IMEI
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

/// Lifecycle of one serialised/IMEI-tracked unit. Phase 34 scope: a registry
/// with uniqueness and scan lookup - status is set directly by staff, not
/// wired into the order/repair/return reservation pipeline.
enum ProductUnitStatus {
  IN_STOCK
  SOLD
  RETURNED
  DAMAGED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// The stock transfer lifecycle: DRAFT -> REQUESTED -> APPROVED -> IN_TRANSIT
/// -> COMPLETED, with CANCELLED reachable from DRAFT/REQUESTED/APPROVED only -
/// once stock has actually left the source (IN_TRANSIT) a transfer runs to
/// completion, the same reasoning as PurchaseOrder refusing to cancel once
/// receiving has started.
enum StockTransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum LocationType {
  STORE
  WAREHOUSE
  SERVICE_CENTER
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// A signed-up company. Every business record belongs to exactly one
/// Organization, enforced by a required `organizationId` on each tenant
/// table (AuditLog is the one exception - see its own comment).
model Organization {
  id                   String             @id @default(uuid(7)) @db.Uuid
  name                 String             @db.VarChar(200)
  stripeCustomerId     String?            @unique @db.VarChar(255)
  stripeSubscriptionId String?            @unique @db.VarChar(255)
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  users                 User[]
  customers             Customer[]
  suppliers             Supplier[]
  categories            Category[]
  brands                Brand[]
  products              Product[]
  inventory             Inventory[]
  orders                Order[]
  repairs               Repair[]
  returns               Return[]
  expenses              Expense[]
  payments              Payment[]
  financialTransactions FinancialTransaction[]
  auditLogs             AuditLog[]
  settings              Setting[]
  stockMovements        StockMovement[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  locations             Location[]
  stockTransfers        StockTransfer[]
  productUnits          ProductUnit[]
  stockCounts           StockCount[]
  notifications         Notification[]
  automationRules       AutomationRule[]

  @@index([subscriptionStatus])
}

/// Operates the platform itself, not any one tenant. Deliberately not a
/// `User` row: `User.organizationId` is a required FK, so a cross-tenant
/// identity cannot be modeled as a tenant-scoped user without weakening that
/// constraint for everyone. Authenticated separately from tenant users, with
/// its own JWT secret and no tenant context - see `platform-admin/` module.
model PlatformAdmin {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @db.Uuid
  firstName      String     @db.VarChar(100)
  lastName       String     @db.VarChar(100)
  email          String     @unique @db.VarChar(255)
  passwordHash   String     @db.VarChar(255)
  role           UserRole   @default(STAFF)
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]
  stockMovements       StockMovement[]
  ordersCreated        Order[]
  repairsAssigned      Repair[]               @relation("RepairTechnician")
  repairStatusChanges  RepairStatusHistory[]
  returnsCreated       Return[]
  expensesCreated      Expense[]
  paymentsRecorded     Payment[]
  transactionsRecorded FinancialTransaction[]
  purchaseOrdersCreated PurchaseOrder[]
  goodsReceiptsRecorded GoodsReceipt[]
  locationAccess        UserLocationAccess[]
  stockTransfersCreated StockTransfer[]
  stockCountsCreated    StockCount[]           @relation("StockCountCreatedBy")
  stockCountsApproved   StockCount[]           @relation("StockCountApprovedBy")
  notifications         Notification[]
  automationRulesCreated AutomationRule[]

  @@index([organizationId])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

/// One row per issued refresh token. Only the hash is stored, so a database
/// leak cannot be replayed against the API. Rotation revokes the old row.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  userAgent String?   @db.VarChar(255)
  ipAddress String?   @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One row per issued password-reset link. Only the hash is stored, mirroring
/// `RefreshToken`: a database leak cannot be replayed against the API. A token
/// is single-use (`usedAt`) and short-lived (`expiresAt`).
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Parties
// ---------------------------------------------------------------------------

model Customer {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  customerCode   String    @db.VarChar(32)
  firstName      String    @db.VarChar(100)
  lastName       String    @db.VarChar(100)
  phone          String    @db.VarChar(32)
  email          String?   @db.VarChar(255)
  address        String?   @db.VarChar(500)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orders  Order[]
  repairs Repair[]
  returns Return[]

  @@unique([organizationId, customerCode])
  @@index([organizationId])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
  @@index([deletedAt])
  @@index([createdAt])
}

model Supplier {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  supplierCode   String    @db.VarChar(32)
  name           String    @db.VarChar(200)
  contactPerson  String?   @db.VarChar(150)
  phone          String    @db.VarChar(32)
  email          String?   @db.VarChar(255)
  address        String?   @db.VarChar(500)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  purchaseOrders PurchaseOrder[]
  preferredByProducts Product[]

  @@unique([organizationId, supplierCode])
  @@index([organizationId])
  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(120)
  slug           String    @db.VarChar(140)
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([deletedAt])
}

model Brand {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(120)
  slug           String    @db.VarChar(140)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([deletedAt])
}

model Product {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  sku            String    @db.VarChar(64)
  barcode        String?   @db.VarChar(64)
  name           String    @db.VarChar(200)
  description    String?
  categoryId     String    @db.Uuid
  brandId        String?   @db.Uuid
  costPrice      Decimal   @db.Decimal(14, 2)
  sellingPrice   Decimal   @db.Decimal(14, 2)
  minimumStock   Int       @default(0)
  isActive       Boolean   @default(true)
  trackingType   ProductTrackingType @default(NONE)
  model          String?   @db.VarChar(120)
  variant        String?   @db.VarChar(120)
  color          String?   @db.VarChar(60)
  storage        String?   @db.VarChar(60)
  condition      ProductCondition @default(NEW)
  warrantyMonths Int?
  /// Reorder planning fields (Phase 36). All optional: a product with no
  /// `reorderPoint` set is simply excluded from reorder suggestions rather
  /// than forcing every product in the catalogue to carry a planning policy.
  reorderPoint         Int?
  targetStock          Int?
  safetyStock          Int?
  supplierLeadTimeDays Int?
  preferredSupplierId  String? @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Restrict: a category or brand that is still in use must be soft-deleted,
  // never dropped out from under its products.
  category          Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand             Brand?       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  preferredSupplier Supplier?    @relation(fields: [preferredSupplierId], references: [id], onDelete: Restrict)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  inventory      Inventory[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  returnItems    ReturnItem[]
  repairItems    RepairItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockTransferItems StockTransferItem[]
  units              ProductUnit[]
  stockCountItems    StockCountItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([name])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([preferredSupplierId])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// A physical place stock lives - a store, warehouse or service centre.
/// Introduced as the foundation for Phase 33 (Stock Transfers); until that
/// phase exists, every organization has exactly one Location (`isDefault =
/// true`) and every stock-moving call site resolves it internally rather than
/// accepting a caller-supplied locationId.
model Location {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(200)
  type           LocationType @default(STORE)
  address        String?      @db.VarChar(500)
  /// Exactly one non-deleted Location per organization may be true - enforced
  /// by a partial unique index in the migration, not by the schema DSL (Prisma
  /// cannot express a partial unique constraint declaratively).
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  inventory      Inventory[]
  stockMovements StockMovement[]
  userAccess     UserLocationAccess[]
  transfersFrom  StockTransfer[]      @relation("StockTransferSource")
  transfersTo    StockTransfer[]      @relation("StockTransferDestination")
  productUnits   ProductUnit[]
  stockCounts    StockCount[]

  @@index([organizationId])
  @@index([deletedAt])
}

/// Restricts a user to a subset of their organization's locations.
///
/// Semantics: empty = unrestricted (the user may access every location in
/// their org), non-empty = allow-list (the user may access only the listed
/// locations). This is the inverse of what "empty list" usually means for a
/// permission table - an admin adding the first restriction row for a user
/// changes that user from unrestricted to restricted; there is no separate
/// "no access" state. ADMIN role always bypasses this restriction regardless
/// of rows present, the same way the outer organization boundary can't be
/// bypassed by anyone.
model UserLocationAccess {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  locationId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([locationId])
}

/// Current stock level, kept separate from the product definition so a price
/// edit never contends with a sale. Updated only inside a transaction that
/// also writes a StockMovement. Per-location: the same product has one row
/// per Location it has ever held stock at.
model Inventory {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @db.Uuid
  productId        String   @db.Uuid
  locationId       String   @db.Uuid
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict: a location holding stock cannot be deleted out from under it.
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([organizationId])
  @@index([quantity])
  @@index([locationId])
}

/// Append-only ledger. Every change to Inventory.quantity has exactly one row
/// here, so the current level is always reconstructable from history.
model StockMovement {
  id               String             @id @default(uuid(7)) @db.Uuid
  organizationId   String             @db.Uuid
  productId        String             @db.Uuid
  locationId       String             @db.Uuid
  type             StockMovementType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  referenceType    StockReferenceType
  referenceId      String?            @db.Uuid
  note             String?            @db.VarChar(500)
  createdById      String             @db.Uuid
  createdAt        DateTime           @default(now())

  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict keeps the ledger attributable: a user with movements cannot be
  // hard-deleted, only deactivated.
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // Restrict: a location with recorded movements cannot be deleted out from under them.
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([productId, createdAt])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdById])
  @@index([createdAt])
  @@index([locationId])
}

/// One row per physically serialised/IMEI unit, for products whose
/// trackingType is SERIAL or IMEI (see Product.trackingType). Independent of
/// Inventory's aggregate quantity - Phase 34 scope is a registry with
/// uniqueness and scan lookup, not unit-level reservation/fulfillment.
model ProductUnit {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  productId      String            @db.Uuid
  locationId     String            @db.Uuid
  serialNumber   String            @db.VarChar(64)
  status         ProductUnitStatus @default(IN_STOCK)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Restrict: a location holding tracked units cannot be deleted out from under them.
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, serialNumber])
  @@index([productId])
  @@index([status])
  @@index([locationId])
}

/// A physical stock count at one location. `StockCountItem.expectedQuantity`
/// is a snapshot taken when the item is added, not a live read of Inventory -
/// a count has to compare against what the system believed at the moment
/// counting started, not against a number that keeps moving under it.
model StockCount {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  countNumber    String           @db.VarChar(32)
  locationId     String           @db.Uuid
  status         StockCountStatus @default(DRAFT)
  notes          String?
  createdById    String           @db.Uuid
  approvedById   String?          @db.Uuid
  approvedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict: a location with recorded counts cannot be deleted out from under them.
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("StockCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("StockCountApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  items        StockCountItem[]

  @@unique([organizationId, countNumber])
  @@index([organizationId])
  @@index([locationId])
  @@index([status])
  @@index([createdAt])
}

/// One line per product included in a count. `countedQuantity` is null until
/// someone counts it; re-entering it (a recount) simply overwrites the
/// previous value while the count is still in COUNTING.
model StockCountItem {
  id               String    @id @default(uuid(7)) @db.Uuid
  stockCountId     String    @db.Uuid
  productId        String    @db.Uuid
  expectedQuantity Int
  countedQuantity  Int?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  // Restrict: a product counted at least once cannot vanish out from under the ledger.
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId])
  @@index([stockCountId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Order {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  orderNumber    String        @db.VarChar(32)
  customerId     String?       @db.Uuid
  status         OrderStatus   @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  discount       Decimal       @default(0) @db.Decimal(14, 2)
  tax            Decimal       @default(0) @db.Decimal(14, 2)
  total          Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(14, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  notes          String?
  createdById    String        @db.Uuid
  /// Set when the order reaches COMPLETED. Revenue reporting keys off this,
  /// not createdAt, so a draft raised last month cannot distort today's sales.
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // A walk-in sale has no customer record.
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items    OrderItem[]
  returns  Return[]
  payments Payment[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdById])
  @@index([completedAt])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  /// Captured at sale time; later price changes must not rewrite history.
  unitPrice Decimal  @db.Decimal(14, 2)
  discount  Decimal  @default(0) @db.Decimal(14, 2)
  total     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  returnItems ReturnItem[]

  @@unique([orderId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Purchasing
// ---------------------------------------------------------------------------

/// The purchasing counterpart of Order: DRAFT -> APPROVED -> ORDERED, then
/// receiving moves it to PARTIALLY_RECEIVED/RECEIVED as GoodsReceipts land
/// against it. Cancellable from DRAFT/APPROVED/ORDERED only - never once any
/// receiving has happened, mirroring how Order.cancel refuses once paid.
model PurchaseOrder {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  poNumber       String              @db.VarChar(32)
  supplierId     String              @db.Uuid
  status         PurchaseOrderStatus @default(DRAFT)
  subtotal       Decimal             @default(0) @db.Decimal(14, 2)
  discount       Decimal             @default(0) @db.Decimal(14, 2)
  tax            Decimal             @default(0) @db.Decimal(14, 2)
  shipping       Decimal             @default(0) @db.Decimal(14, 2)
  total          Decimal             @default(0) @db.Decimal(14, 2)
  expectedDate   DateTime?
  notes          String?
  createdById    String              @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([organizationId, poNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  purchaseOrderId String   @db.Uuid
  productId       String   @db.Uuid
  quantity        Int
  /// What we pay the supplier - distinct from Product.sellingPrice, which is what
  /// we charge a customer. Captured at order time so a later cost change cannot
  /// rewrite a purchase that already happened.
  unitCost        Decimal  @db.Decimal(14, 2)
  discount        Decimal  @default(0) @db.Decimal(14, 2)
  total           Decimal  @db.Decimal(14, 2)
  /// Denormalized running total of GoodsReceiptItem.quantityReceived against this
  /// line, updated by the same conditional UPDATE that admits a receipt - the same
  /// pattern as Inventory.reservedQuantity - so two simultaneous receipts racing to
  /// receive more than what remains outstanding cannot both succeed.
  receivedQuantity Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  goodsReceiptItems GoodsReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

/// One delivery against a PurchaseOrder. Its lines are what actually move
/// stock - creating a GoodsReceipt, the StockMovements it causes and the
/// PurchaseOrder status re-evaluation all happen in one transaction.
model GoodsReceipt {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @db.Uuid
  grNumber        String   @db.VarChar(32)
  purchaseOrderId String   @db.Uuid
  note            String?
  createdById     String   @db.Uuid
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items GoodsReceiptItem[]

  @@unique([organizationId, grNumber])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([createdAt])
}

model GoodsReceiptItem {
  id                  String   @id @default(uuid(7)) @db.Uuid
  goodsReceiptId      String   @db.Uuid
  purchaseOrderItemId String   @db.Uuid
  quantityReceived    Int
  createdAt           DateTime @default(now())

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
}

/// Moves stock between two of the organization's Locations. DRAFT lines are
/// free to edit; APPROVED reserves at the source; IN_TRANSIT consumes at the
/// source; COMPLETED restores at the destination. Two StockMovement rows
/// exist per line once COMPLETED (one TRANSFER_OUT, one TRANSFER_IN), and the
/// combined quantity across both locations is unchanged throughout.
model StockTransfer {
  id                    String               @id @default(uuid(7)) @db.Uuid
  organizationId        String               @db.Uuid
  transferNumber        String               @db.VarChar(32)
  sourceLocationId      String               @db.Uuid
  destinationLocationId String               @db.Uuid
  status                StockTransferStatus  @default(DRAFT)
  notes                 String?
  createdById           String               @db.Uuid
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // Restrict: a location with transfer history cannot be deleted out from under it.
  sourceLocation      Location @relation("StockTransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation Location @relation("StockTransferDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)

  items StockTransferItem[]

  @@unique([organizationId, transferNumber])
  @@index([organizationId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model StockTransferItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  transferId String   @db.Uuid
  productId  String   @db.Uuid
  /// The amount requested/shipped - no partial-shipment concept, a transfer
  /// ships and receives its full requested quantity as one atomic step each.
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Repairs
// ---------------------------------------------------------------------------

model Repair {
  id                   String       @id @default(uuid(7)) @db.Uuid
  organizationId       String       @db.Uuid
  repairNumber         String       @db.VarChar(32)
  customerId           String       @db.Uuid
  deviceType           DeviceType
  /// Manufacturer of the customer's device - unrelated to the sales catalogue.
  brand                String?      @db.VarChar(100)
  model                String?      @db.VarChar(100)
  serialNumber         String?      @db.VarChar(100)
  imei                 String?      @db.VarChar(32)
  problemDescription   String
  diagnosis            String?
  estimatedCost        Decimal?     @db.Decimal(14, 2)
  finalCost            Decimal?     @db.Decimal(14, 2)
  technicianId         String?      @db.Uuid
  status               RepairStatus @default(RECEIVED)
  receivedAt           DateTime     @default(now())
  expectedCompletionAt DateTime?
  completedAt          DateTime?
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technician   User?        @relation("RepairTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items         RepairItem[]
  statusHistory RepairStatusHistory[]
  payments      Payment[]

  @@unique([organizationId, repairNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([technicianId])
  @@index([status])
  @@index([receivedAt])
  @@index([completedAt])
  @@index([serialNumber])
  @@index([imei])
}

/// Parts consumed by a repair. Consumption deducts stock through a
/// REPAIR_OUT movement in the same transaction.
model RepairItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  repairId  String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  unitPrice Decimal  @db.Decimal(14, 2)
  total     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repair  Repair  @relation(fields: [repairId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([repairId, productId])
  @@index([productId])
}

model RepairStatusHistory {
  id          String        @id @default(uuid(7)) @db.Uuid
  repairId    String        @db.Uuid
  /// Null on the first row, which records intake.
  fromStatus  RepairStatus?
  toStatus    RepairStatus
  note        String?       @db.VarChar(500)
  changedById String        @db.Uuid
  createdAt   DateTime      @default(now())

  repair    Repair @relation(fields: [repairId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([repairId, createdAt])
  @@index([changedById])
}

// ---------------------------------------------------------------------------
// Returns
// ---------------------------------------------------------------------------

model Return {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  returnNumber   String       @db.VarChar(32)
  orderId        String       @db.Uuid
  customerId     String?      @db.Uuid
  reason         ReturnReason
  reasonNote     String?
  status         ReturnStatus @default(PENDING)
  refundAmount   Decimal      @default(0) @db.Decimal(14, 2)
  createdById    String       @db.Uuid
  /// Set when the return reaches COMPLETED, which is when stock is restored
  /// and the refund is recorded.
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items    ReturnItem[]
  payments Payment[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model ReturnItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  returnId    String   @db.Uuid
  orderItemId String   @db.Uuid
  productId   String   @db.Uuid
  quantity    Int
  unitPrice   Decimal  @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  /// False for goods that come back unsellable; those are refunded without a
  /// RETURN_IN movement.
  restock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  returnRecord Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
  @@index([productId])
  @@index([orderItemId])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Expense {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @db.Uuid
  expenseNumber  String          @db.VarChar(32)
  category       ExpenseCategory
  description    String          @db.VarChar(500)
  amount         Decimal         @db.Decimal(14, 2)
  expenseDate    DateTime        @db.Date
  createdById    String          @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, expenseNumber])
  @@index([organizationId])
  @@index([category])
  @@index([expenseDate])
  @@index([createdById])
  @@index([createdAt])
}

/// Money actually moved. Exactly one of orderId / repairId / returnId is set,
/// matching `referenceType`; the pairing is enforced by a check constraint.
model Payment {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @db.Uuid
  paymentNumber  String               @db.VarChar(32)
  method         PaymentMethod
  amount         Decimal              @db.Decimal(14, 2)
  referenceType  PaymentReferenceType
  orderId        String?              @db.Uuid
  repairId       String?              @db.Uuid
  returnId       String?              @db.Uuid
  /// External reference such as a card authorisation or transfer id.
  reference      String?              @db.VarChar(120)
  note           String?              @db.VarChar(500)
  paidAt         DateTime             @default(now())
  createdById    String               @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  order        Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  repair       Repair?      @relation(fields: [repairId], references: [id], onDelete: Restrict)
  returnRecord Return?      @relation(fields: [returnId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([orderId])
  @@index([repairId])
  @@index([returnId])
  @@index([method])
  @@index([paidAt])
  @@index([createdById])
}

/// Ledger of financial events used by the dashboard and reports. `amount` is
/// always non-negative; `type` determines whether it is income or outflow.
model FinancialTransaction {
  id             String                    @id @default(uuid(7)) @db.Uuid
  organizationId String                    @db.Uuid
  type           TransactionType
  amount         Decimal                   @db.Decimal(14, 2)
  description    String                    @db.VarChar(500)
  occurredAt     DateTime                  @default(now())
  referenceType  TransactionReferenceType?
  referenceId    String?                   @db.Uuid
  createdById    String                    @db.Uuid
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@index([occurredAt])
  @@index([referenceType, referenceId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Audit and settings
// ---------------------------------------------------------------------------

/// Append-only trail of security- and money-relevant events.
/// `metadata` never carries passwords, tokens or other secrets.
model AuditLog {
  id             String      @id @default(uuid(7)) @db.Uuid
  /// Null for events with no organization context yet, e.g. a failed login
  /// against an email that doesn't exist - stays nullable even after other
  /// tenant tables are tightened to NOT NULL in the next migration.
  organizationId String?     @db.Uuid
  /// Null for events with no authenticated actor, such as a failed login.
  userId         String?     @db.Uuid
  action         AuditAction
  entity         AuditEntity
  entityId       String?     @db.Uuid
  metadata       Json?
  ipAddress      String?     @db.VarChar(64)
  userAgent      String?     @db.VarChar(255)
  createdAt      DateTime    @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  key            String           @db.VarChar(100)
  value          String
  valueType      SettingValueType @default(STRING)
  description    String?          @db.VarChar(500)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

/// In-app notifications fanned out to the users who act on a business event
/// (an ADMIN/MANAGER for most events, plus the assigned technician for a
/// repair). Delivery is deliberately just this one row today - a future
/// email/SMS/push channel reads the same row rather than needing its own
/// model, per the "keep delivery channels abstract" instruction.
model Notification {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(200)
  message        String           @db.VarChar(1000)
  /// What this notification is about, e.g. entityType "REPAIR" + entityId the
  /// repair's id, so the UI can link straight to the record. Null for
  /// organization-wide events (a trial expiring) with no single record.
  entityType     String?          @db.VarChar(40)
  entityId       String?          @db.Uuid
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, isRead, createdAt])
  @@index([entityType, entityId])
}

/// WHEN `triggerType` fires, IF every condition matches the event's own
/// context, THEN perform `actionType`. `conditions` is data, not code: each
/// entry is one `{field, operator, value}` comparison evaluated in
/// `automation/evaluate-automation.ts` against a plain object the trigger
/// site supplies (e.g. LOW_STOCK's context has `sku`, `categoryName`,
/// `quantity`) - there is no expression language and nothing here is ever
/// passed to `eval` or a template engine.
model AutomationRule {
  id             String                      @id @default(uuid(7)) @db.Uuid
  organizationId String                      @db.Uuid
  name           String                      @db.VarChar(150)
  triggerType    NotificationType
  conditions     Json                        @default("[]")
  actionType     AutomationActionType        @default(NOTIFY)
  /// Who NOTIFY fans out to - on top of, not instead of, that event's own default audience.
  actionRoles    UserRole[]
  isActive       Boolean                     @default(true)
  createdById    String                      @db.Uuid
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([triggerType, isActive])
}
