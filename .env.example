# ---------------------------------------------------------------------------
# Stock Pro - environment template
#
# Copy this file to `.env` at the repository root and fill in real values.
# `.env` is git-ignored. Never commit real secrets.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Runtime mode: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Must match the credentials used by infrastructure/docker-compose.yml.
# The container publishes on 5433 so it does not collide with a natively
# installed PostgreSQL on 5432.
# ---------------------------------------------------------------------------
POSTGRES_USER=stockpro
POSTGRES_PASSWORD=stockpro
POSTGRES_DB=stockpro
POSTGRES_PORT=5433
DATABASE_URL=postgresql://stockpro:stockpro@localhost:5433/stockpro?schema=public

# ---------------------------------------------------------------------------
# Backend API (apps/api)
# ---------------------------------------------------------------------------
API_PORT=4000

# Required, minimum 32 characters, and the two MUST differ - sharing one secret
# would let a stolen refresh token be replayed as an access token.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access tokens are held in memory by the client and kept short-lived; the
# refresh token lives in an httpOnly cookie and is rotated on every use.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API.
WEB_URL=http://localhost:3001

# Rate limiting: THROTTLE_LIMIT requests per THROTTLE_TTL seconds, per client.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Swagger UI at /api/docs. Defaults to enabled everywhere except production;
# set explicitly to 'true' or 'false' to override.
# SWAGGER_ENABLED=true

# Stripe billing. Optional: the API boots and runs fine without these, it
# just cannot process checkouts until they are set. STRIPE_PRICE_ID is the
# id of the single subscription Price this deployment sells. Register the
# webhook locally with the Stripe CLI:
#   stripe listen --forward-to localhost:4000/api/v1/billing/webhook
# and use the signing secret it prints for STRIPE_WEBHOOK_SECRET.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# Platform admin: the cross-tenant operator panel at /platform/login, entirely
# separate from tenant auth. Required (unlike Stripe above) - it gates a real
# capability (suspending a tenant), so the API refuses to boot without it, the
# same as the two JWT secrets below. Generate the same way:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PLATFORM_ADMIN_JWT_SECRET=

# Optional: only read by `pnpm db:seed`, to create the one PlatformAdmin row.
# Leave unset to seed everything else without a platform-admin account.
# PLATFORM_ADMIN_EMAIL=platform-admin@stockpro.test
# PLATFORM_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend (apps/web)
# NEXT_PUBLIC_* values are inlined into the browser bundle - never put secrets here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
